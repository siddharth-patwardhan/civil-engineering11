# Server-only: never expose to the Vite client bundle.
GEMINI_API_KEY=""

# PostgreSQL (e.g. docker compose in this repo: civil/civil @ localhost:5432)
DATABASE_URL="postgresql://civil:civil@localhost:5432/civil_estimation"

# Optional: verify Supabase-issued JWTs on protected routes (Bearer <jwt>)
SUPABASE_JWT_SECRET=""

APP_URL="http://localhost:3000"
